# Copy this file to ".env" and fill in your own key.
# Get a key at https://console.anthropic.com  (Settings -> API Keys).
# Keep this file private — never commit it, never share it.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model id. Check current ids at
# https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: model for the Claude Code CLI (subscription) path.
# "sonnet" (recommended), "haiku" (cheapest), or "opus" (best prose, heaviest).
# This only affects the written briefing — all trade numbers are code.
CLAUDE_CLI_MODEL=sonnet

# Optional: port
PORT=5057
